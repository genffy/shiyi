{
  "name": "shiyi",
  "version": "0.1.0",
  "description": "shiyi（拾遗）— unify AI chat sessions scattered across tools into a personal knowledge base",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "shiyi": "./src/cli/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "sync": "tsx src/cli/index.ts sync",
    "serve": "tsx src/cli/index.ts serve",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "dompurify": "^3.4.15",
    "fastify": "^5.2.0",
    "fflate": "^0.8.2",
    "marked": "^18.0.13",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^3.0.0"
  }
}
